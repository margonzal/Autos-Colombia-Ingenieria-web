# Puerto del Servidor Backend
PORT=5000

# Conexión a Base de Datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=autos_colombia
DB_PORT=3306

# Clave Secreta para Tokens JWT
JWT_SECRET=cambiar_por_una_clave_secreta_segura_jwt
